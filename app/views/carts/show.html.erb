<h1 class="mb-4 text-center">Your Shopping Cart</h1>

<% if @cart.cart_items.any? %>
  <!-- Shopping Cart Table -->
  <div class="table-responsive">
    <table class="table table-bordered align-middle">
      <thead class="table-light text-center">
        <tr>
          <th>Product</th>
          <th>Quantity</th>
          <th>Price</th>
          <th>Subtotal</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @cart.cart_items.each do |cart_item| %>
          <tr>
            <!-- Product Details -->
            <td class="d-flex align-items-center">
              <% if cart_item.product.image.attached? %>
                <%= image_tag cart_item.product.image.variant(resize_to_limit: [100, 100]), class: "rounded me-3", alt: cart_item.product.name %>
              <% else %>
                <%= image_tag "placeholder.jpg", class: "rounded me-3", alt: "Product image" %>
              <% end %>
              <%= link_to cart_item.product.name, product_path(cart_item.product), class: "text-decoration-none text-dark fw-bold" %>
            </td>
            
            <!-- Quantity Update -->
            <td>
              <%= form_with url: update_item_cart_path(cart_item), method: :patch, local: true, class: "d-flex align-items-center" do |form| %>
                <%= form.number_field :quantity, value: cart_item.quantity, min: 1, class: "form-control text-center me-2 cart-quantity-input", style: "width: 70px;" %>
                <%= form.submit "Update", class: "btn btn-sm btn-outline-primary" %>
              <% end %>
            </td>

            <!-- Price and Subtotal -->
            <td class="text-center">$<%= cart_item.product.price %></td>
            <td class="text-center">$<%= cart_item.product.price * cart_item.quantity %></td>
            
            <!-- Remove Button -->
            <td class="text-center">
              <%= button_to "Remove", remove_item_cart_path(cart_item), method: :delete, class: "btn btn-sm btn-danger", data: { confirm: "Are you sure?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
      
      <!-- Total Row -->
      <tfoot>
        <tr>
          <td colspan="3" class="text-end fw-bold">Total:</td>
          <td colspan="2" class="text-center fw-bold">$<%= @cart.cart_items.sum { |item| item.product.price * item.quantity } %></td>
        </tr>
      </tfoot>
    </table>
  </div>

  <!-- Action Buttons -->
  <div class="d-flex justify-content-between mt-4">
    <%= link_to "Continue Shopping", products_path, class: "btn btn-outline-secondary btn-lg" %>
    <%= link_to "Proceed to Checkout", new_order_path, class: "btn btn-primary btn-lg" %>
  </div>
<% else %>
  <!-- Empty Cart Message -->
  <div class="text-center py-5">
    <h3>Your cart is empty.</h3>
    <p class="text-muted">Start adding items to your cart to see them here.</p>
    <%= link_to "Browse Products", products_path, class: "btn btn-primary btn-lg mt-3" %>
  </div>
<% end %>
