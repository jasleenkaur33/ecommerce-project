<h1 class="text-center mb-4">Checkout</h1>

<% if @cart.cart_items.any? %>
  <!-- Order Summary Section -->
  <div class="mb-5">
    <h2 class="text-primary">Order Summary</h2>
    <div class="table-responsive">
      <table class="table table-bordered">
        <thead class="table-light">
          <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Price</th>
            <th>Subtotal</th>
          </tr>
        </thead>
        <tbody>
          <% @cart.cart_items.each do |item| %>
            <tr>
              <!-- Product Name -->
              <td>
                <% if item.product.image.attached? %>
                  <%= image_tag item.product.image.variant(resize_to_limit: [60, 60]), class: "rounded me-2", alt: item.product.name %>
                <% else %>
                  <%= image_tag "placeholder.jpg", class: "rounded me-2", alt: "Product image" %>
                <% end %>
                <%= link_to item.product.name, product_path(item.product), class: "text-decoration-none text-dark fw-bold" %>
              </td>

              <!-- Quantity -->
              <td class="text-center"><%= item.quantity %></td>

              <!-- Price -->
              <td class="text-center">$<%= item.product.price %></td>

              <!-- Subtotal -->
              <td class="text-center">$<%= item.quantity * item.product.price %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="3" class="text-end fw-bold">Total:</td>
            <td class="text-center fw-bold text-success">$<%= @cart.cart_items.sum { |item| item.product.price * item.quantity } %></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>

  <!-- Checkout Form -->
  <%= form_with model: @order, url: orders_path, method: :post, local: true do |form| %>
    <!-- Shipping Address Section -->
    <h2 class="text-primary">Shipping Address</h2>
    <div class="mb-4">
      <div class="form-group mb-3">
        <%= form.label :address_id, "Choose an existing address:", class: "form-label" %>
        <%= form.collection_select :address_id, current_user.addresses, :id, :line1, { prompt: "Select an Address" }, class: "form-select" %>
      </div>
    </div>

    <h3 class="text-secondary">Or Add a New Address</h3>
    <div class="row g-3">
      <%= form.fields_for :address do |address_form| %>
        <div class="col-md-6">
          <%= address_form.label :line1, "Address Line 1", class: "form-label" %>
          <%= address_form.text_field :line1, class: "form-control" %>
        </div>
        <div class="col-md-6">
          <%= address_form.label :line2, "Address Line 2 (Optional)", class: "form-label" %>
          <%= address_form.text_field :line2, class: "form-control" %>
        </div>
        <div class="col-md-4">
          <%= address_form.label :city, "City", class: "form-label" %>
          <%= address_form.text_field :city, class: "form-control" %>
        </div>
        <div class="col-md-4">
          <%= address_form.label :province_id, "Province/State", class: "form-label" %>
          <%= address_form.collection_select :province_id, Province.all, :id, :name, {}, class: "form-select" %>
        </div>
        <div class="col-md-4">
          <%= address_form.label :postal_code, "Postal Code", class: "form-label" %>
          <%= address_form.text_field :postal_code, class: "form-control" %>
        </div>
      <% end %>
    </div>

    <!-- Submit Button -->
    <div class="mt-4 text-center">
      <%= form.submit "Place Order", class: "btn btn-success btn-lg" %>
    </div>
  <% end %>
<% else %>
  <!-- Empty Cart Message -->
  <div class="text-center py-5">
    <h3>Your cart is empty.</h3>
    <p class="text-muted">Add items to your cart to proceed with checkout.</p>
    <%= link_to "Start Shopping", products_path, class: "btn btn-primary btn-lg mt-3" %>
  </div>
<% end %>
