<%= form_with model: product, local: true do |form| %>
    <div class="form-group">
      <%= form.label :name, "Product Name:" %>
      <%= form.text_field :name, class: "form-control" %>
    </div>
  
    <div class="form-group">
      <%= form.label :description, "Description:" %>
      <%= form.text_area :description, rows: 5, class: "form-control" %>
    </div>
  
    <div class="form-group">
      <%= form.label :price, "Price ($):" %>
      <%= form.number_field :price, step: 0.01, class: "form-control" %>
    </div>
  
    <div class="form-group">
      <%= form.label :category_id, "Category:" %>
      <%= form.collection_select :category_id, Category.all, :id, :name, { prompt: "Select Category" }, class: "form-control" %>
    </div>
  
    <div class="form-group">
      <%= form.label :image, "Product Image:" %>
      <%= form.file_field :image, class: "form-control" %>
    </div>
  
    <%= form.submit "Save", class: "btn btn-primary" %>
  <% end %>
  