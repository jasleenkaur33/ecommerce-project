<h1 class="mb-4">Products</h1>

<!-- Search and Filter Section -->
<div class="mb-4">
  <div class="row">
    <!-- Search Bar -->
    <div class="col-md-8">
      <%= form_with url: search_products_path, method: :get, local: true do %>
        <div class="input-group">
          <%= text_field_tag :query, params[:query], placeholder: "Search products...", class: "form-control" %>
          <%= select_tag :category_id, options_from_collection_for_select(@categories, :id, :name, params[:category_id]), prompt: "All Categories", class: "form-select" %>
          <%= submit_tag "Search", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
    <!-- Filters -->
    <div class="col-md-4 text-end">
      <%= link_to "All Products", products_path, class: "btn btn-outline-secondary me-2" %>
      <%= link_to "On Sale", products_path(filter: "on_sale"), class: "btn btn-primary me-2" %>
      <%= link_to "New Products", products_path(filter: "new"), class: "btn btn-success me-2" %>
      <%= link_to "Recently Updated", products_path(filter: "recently_updated"), class: "btn btn-info" %>
    </div>
  </div>
</div>

<!-- Product Grid -->
<div class="row row-cols-1 row-cols-md-3 g-4">
  <% @products.each do |product| %>
    <div class="col">
      <div class="card h-100 shadow-sm">
        <!-- Product Image -->
        <% if product.image.attached? %>
          <%= image_tag product.image, class: "card-img-top", alt: product.name %>
        <% else %>
          <%= image_tag "placeholder.jpg", class: "card-img-top", alt: "Product image" %>
        <% end %>
        <div class="card-body">
          <!-- Product Details -->
          <h5 class="card-title"><%= product.name %></h5>
          <p class="card-text">
            <strong>$<%= product.price %></strong>
            <% if product.on_sale %>
              <span class="badge bg-warning text-dark">On Sale</span>
            <% end %>
          </p>
          <!-- CTA Button -->
          <%= link_to "View Details", product_path(product), class: "btn btn-primary btn-sm w-100" %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<!-- Pagination -->
<div class="d-flex justify-content-center mt-4">
  <%= paginate @products %>
</div>
