<div class="container py-4">
  <h1 class="text-center mb-4"><%= @product.new_record? ? "Add New Product" : "Edit Product" %></h1>

  <div class="card shadow p-4">
    <%= form_with model: [:admin, product], local: true do |form| %>
      <!-- Product Name -->
      <div class="mb-3">
        <%= form.label :name, "Product Name", class: "form-label fw-bold" %>
        <%= form.text_field :name, class: "form-control", placeholder: "Enter product name" %>
      </div>

      <!-- Description -->
      <div class="mb-3">
        <%= form.label :description, "Description", class: "form-label fw-bold" %>
        <%= form.text_area :description, class: "form-control", rows: 5, placeholder: "Enter product description" %>
      </div>

      <!-- Price -->
      <div class="mb-3">
        <%= form.label :price, "Price (USD)", class: "form-label fw-bold" %>
        <%= form.number_field :price, step: 0.01, class: "form-control", placeholder: "Enter product price" %>
      </div>

      <!-- Category -->
      <div class="mb-3">
        <%= form.label :category_id, "Category", class: "form-label fw-bold" %>
        <%= form.collection_select :category_id, Category.all, :id, :name, { prompt: "Select Category" }, class: "form-control" %>
      </div>

      <!-- Product Image -->
      <div class="mb-3">
        <%= form.label :image, "Upload Product Image", class: "form-label fw-bold" %>
        <%= form.file_field :image, class: "form-control" %>
      </div>

      <!-- Current Image Preview -->
      <% if @product.image.attached? %>
        <div class="mb-3">
          <p class="fw-bold">Current Image:</p>
          <div class="mb-2">
            <%= image_tag @product.image.variant(resize_to_limit: [150, 150]), class: "img-thumbnail" %>
          </div>
          <%= check_box_tag :remove_image, "1" %>
          <%= label_tag :remove_image, "Remove image", class: "form-check-label" %>
        </div>
      <% end %>

      <!-- Submit Button -->
      <div class="text-center">
        <%= form.submit @product.new_record? ? "Add Product" : "Update Product", class: "btn btn-primary btn-lg" %>
      </div>
    <% end %>
  </div>
</div>
