<div class="container py-4">
  <h1 class="text-center mb-4">Manage Categories</h1>

  <div class="mb-3 text-end">
    <%= link_to "Add New Category", new_admin_category_path, class: "btn btn-success btn-lg" %>
  </div>

  <div class="card shadow p-4">
    <% if @categories.any? %>
      <table class="table table-bordered table-hover">
        <thead class="table-dark text-center">
          <tr>
            <th scope="col">ID</th>
            <th scope="col">Name</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @categories.each do |category| %>
            <tr class="text-center">
              <td><%= category.id %></td>
              <td><%= category.name %></td>
              <td>
                <div class="row">
                <div class="col ">
                
                <%= link_to "Edit", edit_admin_category_path(category), class: "btn btn-sm btn-warning me-2" %>
                </div>
                <div class="col">
                  <%= button_to "Delete", admin_category_path(category), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" %>
                </div>
                </div>
                </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="alert alert-info text-center" role="alert">
        No categories found. <%= link_to "Add one now", new_admin_category_path, class: "alert-link" %>.
      </div>
    <% end %>
  </div>
</div>
