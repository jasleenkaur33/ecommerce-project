<div class="container py-5">
  <div class="card shadow-lg p-4">
    <h1 class="text-center mb-4">Order #<%= @order.id %></h1>

    <div class="order-summary mb-4">
      <p><strong>User:</strong> <%= @order.user.email %></p>
      <p><strong>Status:</strong> <%= @order.status.humanize %></p>
      <p><strong>Total Price:</strong> $<%= @order.total_price %></p>
    </div>

    <h2 class="mt-4 mb-3">Order Items</h2>
    <table class="table table-bordered table-striped">
      <thead>
        <tr>
          <th>Product</th>
          <th>Quantity</th>
          <th>Price</th>
          <th>Subtotal</th>
        </tr>
      </thead>
      <tbody>
        <% @order.order_items.each do |item| %>
          <tr>
            <td><%= item.product.name %></td>
            <td><%= item.quantity %></td>
            <td>$<%= item.price %></td>
            <td>$<%= item.quantity * item.price %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <h2 class="mt-4">Change Order Status</h2>
    <%= form_with model: @order, url: admin_order_path(@order), method: :patch, local: true do |form| %>
      <div class="form-group mb-4">
        <%= form.label :status, "Order Status", class: "form-label" %>
        <%= form.select :status, Order.statuses.keys.map { |status| [status.humanize, status] }, {}, class: "form-control" %>
      </div>
      <div class="text-center">
        <%= form.submit "Update Status", class: "btn btn-primary btn-lg" %>
      </div>
    <% end %>

    <div class="text-center mt-4">
      <%= link_to "Back to Orders", admin_orders_path, class: "btn btn-secondary btn-lg" %>
    </div>
  </div>
</div>
